# 本地 Docker MySQL 初始化配置；正式部署请替换 root 密码
MYSQL_ROOT_PASSWORD=123456
# 后端专用数据库账号（Compose 会映射为 MySQL 镜像需要的 MYSQL_USER / MYSQL_PASSWORD）
APP_DB_USER=students_manager_app
APP_DB_PASSWORD=replace-with-a-strong-app-database-password
# 生产 JWT 签名密钥
JWT_SECRET=replace-with-at-least-32-random-bytes
# SM4 联系方式加密密钥
SM4_KEY_BASE64=replace-with-base64-encoded-16-byte-random-key
# 可选项
JWT_EXPIRATION=1800000
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
MYSQL_PORT=3308
HTTP_PORT=80
